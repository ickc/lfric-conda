#!Jinja2
# Example Cylc site config: Isambard 3. Same content as the one lfric-env-isambard
# ships in its module. To use it, point Cylc at the directory ABOVE flow/:
#     export CYLC_SITE_CONF_PATH=<this repo>/examples/site-config/isambard3
# Anything in your own ~/.cylc/flow/global.cylc is merged on top and wins.
# See docs/site-config.md.

[platforms]
    # The compute nodes, through Slurm. Submit a suite's tasks here with
    # -S CYLC_PLATFORM=isambard3 (the examples default to localhost).
    [[isambard3]]
        hosts = localhost
        job runner = slurm
        install target = localhost

{# Run directories on the project filesystem, not in $HOME, which is small. Cylc
   appends cylc-run/<workflow> itself, so this is $PROJECTDIR/$USER, not
   .../cylc-run. Left to Cylc's default (~/cylc-run) where PROJECTDIR is unset. #}
{% set projectdir = environ.get('PROJECTDIR', '') %}
{% set user = environ.get('USER', '') %}
{% if projectdir and user %}
[install]
    [[symlink dirs]]
        [[[localhost]]]
            run = {{ projectdir }}/{{ user }}
{% endif %}
